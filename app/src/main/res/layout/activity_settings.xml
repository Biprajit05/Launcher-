<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Open animation style" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/styleGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/styleWindow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expand window from icon (smooth)" />
            <RadioButton android:id="@+id/styleScale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scale from icon (system)" />
            <RadioButton android:id="@+id/styleFade" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fade" />
            <RadioButton android:id="@+id/styleSlide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slide up" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Animation speed" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/speedGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/speedFast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fast (250 ms)" />
            <RadioButton android:id="@+id/speedNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal (450 ms)" />
            <RadioButton android:id="@+id/speedSlow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Slow (800 ms)" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="App drawer columns" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/colsGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/cols4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" />
            <RadioButton android:id="@+id/cols5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Icon shape" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/shapeGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/shapeOriginal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Original" />
            <RadioButton android:id="@+id/shapeCircle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Circle" />
            <RadioButton android:id="@+id/shapeSquircle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Squircle" />
            <RadioButton android:id="@+id/shapeRounded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rounded square" />
            <RadioButton android:id="@+id/shapeSquare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Square" />
            <RadioButton android:id="@+id/shapeTeardrop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teardrop" />
        </RadioGroup>

        <TextView android:id="@+id/sizeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Icon size: 100%" android:textSize="16sp" android:textStyle="bold" />
        <SeekBar android:id="@+id/sizeBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:max="80" />

        <TextView android:id="@+id/labelSizeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Label size: 100%" android:textSize="16sp" android:textStyle="bold" />
        <SeekBar android:id="@+id/labelSizeBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:max="100" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Home screen grid (columns × rows)" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/homeGridGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/grid4x6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 × 6" />
            <RadioButton android:id="@+id/grid4x7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 × 7" />
            <RadioButton android:id="@+id/grid5x6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 × 6" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="App drawer background" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/drawerColorGroup" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/dcAuto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto (match wallpaper)" />
            <RadioButton android:id="@+id/dcLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Light" />
            <RadioButton android:id="@+id/dcDark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark" />
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/transLabel" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Transparency effect: 85%" android:textSize="15sp" />
            <Button android:id="@+id/transRestore" style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restore" />
        </LinearLayout>
        <SeekBar android:id="@+id/transBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Opaque" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transparent" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/blurLabel" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Blur effect: 55%" android:textSize="15sp" />
            <Button android:id="@+id/blurRestore" style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restore" />
        </LinearLayout>
        <SeekBar android:id="@+id/blurBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Clear" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blurry" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Dock" android:textSize="16sp" android:textStyle="bold" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dockSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Show dock" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/dockBgSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Dock background" />
        <Button android:id="@+id/resetDock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Reset dock apps" />

        <Button android:id="@+id/resetHome" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Reset home screen layout" />
    </LinearLayout>
</ScrollView>
